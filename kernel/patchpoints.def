PP(S4, "pd_cp_manager", "pdm_main_sm", 0x98, 0xf85d0340, cpfix_pre_start_slave)
PP(S5, "sc8551", "sc8551_dump_important_regs", 0x40, 0x35000060, cpfix_pre_start_converter)
PP(S6, "pd_cp_manager", "pdm_main_sm", 0x6f8, 0x7100113f, cpfix_pre_start_dispatch)
